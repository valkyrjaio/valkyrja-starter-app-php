<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         backupGlobals="false"
         bootstrap="./bootstrap.php"
         colors="true"
         processIsolation="false"
         stopOnError="false"
         stopOnFailure="false"
         cacheDirectory=".phpunit.cache"
         backupStaticProperties="false"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         executionOrder="defects,random"
         resolveDependencies="true"
>
    <coverage>
        <report>
            <clover outputFile="build/logs/clover.xml"/>
            <html outputDirectory="coverage-html"/>
            <php outputFile="build/cov/coverage.cov"/>
        </report>
    </coverage>

    <testsuites>
        <testsuite name="Generated Data Test Suite">
            <directory suffix="Test.php">./tests</directory>
        </testsuite>
    </testsuites>

    <logging/>

    <source>
        <include>
            <!-- The sindri-generated data classes, as they run in production -->
            <directory suffix="Data.php">../../../app/src/App/Http/Data</directory>
            <directory suffix="Data.php">../../../app/src/App/Cli/Data</directory>
            <directory suffix="Data.php">../../../app/src/App/Grpc/Data</directory>
        </include>
        <exclude>
            <!-- Example/template stubs are copied by users, never autoloaded -->
            <directory suffix=".example.php">../../../app/src</directory>
        </exclude>
    </source>
</phpunit>
