use App\Grpc\App;
use App\Grpc\Config;
use Valkyrja\Grpc\Message\Call\ServiceCall;
use Valkyrja\Grpc\Message\Response\Contract\ServiceResponseContract;

require_once __DIR__ . '/../../vendor/autoload.php';

// Dispatch each argument through the worker lifecycle a transport adapter drives.
$app  = App::bootstrap(new Config());
$data = $app->getContainer()->getData();

/** @var string[] $arguments */
$arguments = array_slice($argv, 1);

foreach ($arguments as $argument) {
    [$method, $message] = array_pad(explode('=', $argument, 2), 2, '');

    App::dispatch(
        $app,
        $data,
        ServiceCall::unary($method, $message),
        static function (ServiceResponseContract $response) use ($method): void {
            echo $method . ' ' . $response->getStatus()->getCode()->name;

            foreach ($response->getMessages() as $responseMessage) {
                echo ' ' . $responseMessage;
            }

            echo \PHP_EOL;
        }
    );
}
