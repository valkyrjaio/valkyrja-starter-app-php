#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * This file is part of the Valkyrja Framework package.
 *
 * (c) Melech Mizrachi <melechmizrachi@gmail.com>
 *
 * For the full copyright and license information, please view the LICENSE
 * file that was distributed with this source code.
 */

use App\Queue\Config;
use App\Queue\Job\FlakyJob;
use App\Queue\Job\SendWelcomeEmailJob;
use Valkyrja\Application\Entry\Queue;
use Valkyrja\Queue\Client\Manager\DeferredClient;
use Valkyrja\Queue\Client\Manager\InMemoryClient;
use Valkyrja\Queue\Client\Manager\SyncClient;
use Valkyrja\Queue\Message\Job\Factory\JobFactory;
use Valkyrja\Queue\Message\Job\Job;

require_once __DIR__ . '/../../vendor/autoload.php';

/*
 * Demonstrates the three in-process adapters: produce and consume fuse into one
 * process, no broker required.
 *
 * This is deliberately a *testing* shape. In a real deployment an app pushes to
 * a broker and a separate worker consumes it; an app self-consuming its own
 * jobs is almost only ever something you want in a test or a zero-infrastructure
 * dev environment. It is exercised here precisely because that is where these
 * adapters earn their keep — and because app code only ever calls
 * `Client::push`, swapping any of them for a real broker is a config change
 * with no code change at all.
 *
 * Consumption is made observable through the retry chain: a retry hands an
 * incremented job back to the client, so the number of jobs the client was
 * handed is external proof the job was actually run and settled, not merely
 * enqueued.
 *
 * Usage: queue-internal <sync|deferred|inmemory> [ack|retry]
 */
$adapter = $argv[1] ?? 'sync';
$mode    = $argv[2] ?? 'ack';

$config = new Config();

$job = $mode === 'retry'
    // maxAttempts of 3 means: run, retry, retry, then dead-letter — 3 handovers
    ? new Job(name: FlakyJob::NAME, maxAttempts: 3)
    : new JobFactory()->create(SendWelcomeEmailJob::NAME, ['user_id' => 42]);

switch ($adapter) {
    case 'sync':
        // Runs the job now, blocking, retries and all
        $client = new SyncClient(config: $config);

        $client->push($job);

        echo 'handled=', count($client->getPushed()), PHP_EOL;

        break;

    case 'deferred':
        // Buffers; the host drains it once the response is out
        $client = new DeferredClient(config: $config);

        $client->push($job);

        echo 'buffered=', count($client->getBuffered()), ' handled=0', PHP_EOL;

        $client->drain();

        echo 'handled=', count($client->getPushed()), PHP_EOL;

        break;

    case 'inmemory':
        // Buffers and holds — nothing runs until a test drains it and feeds
        // each job to the entry, which is the documented test flow
        $client = new InMemoryClient();

        $client->push($job);

        echo 'buffered=', count($client->getBuffered()), ' handled=0', PHP_EOL;

        foreach ($client->drain() as $drained) {
            Queue::run(config: $config, job: $drained, client: $client);
        }

        echo 'handled=', count($client->getPushed()), PHP_EOL;

        break;

    default:
        throw new InvalidArgumentException("Unknown adapter `$adapter`");
}
